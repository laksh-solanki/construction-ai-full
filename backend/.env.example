# Environment Configuration (development | staging | production)
ENVIRONMENT=development

# Database Connection (SQLite default, or PostgreSQL)
DATABASE_URL=sqlite:///./buildsight.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/buildsight

# CORS Allowed Origins (Comma-separated list or * for development)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Path to YOLOv8 Custom Weights
YOLO_MODEL_PATH=../ai-model/weights/best.pt

# Application Secret Key (In production, generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-for-production-use-strong-random-key

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_BASE_BACKOFF_SECONDS=2
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300

# File Upload Safety
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
